  <link name="world"/>
  

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.5 0.5 0.5" rpy="0 0 0"/> <!-- Base raised by 0.1 meters or else it collides with the ground-->
  </joint>

  <joint name="Joint_1" type="revolute">
    <origin xyz="0.185 -0.085 -0.085" rpy="3.1416 0 1.5708" />
    <parent link="base_link" />
    <child link="Link_1" />
    <axis xyz="0 0 1" />
    <limit lower="-12.567" upper="12.567" effort="100" velocity="3.141" />
  </joint>

  <joint name="Joint_2" type="revolute">
    <origin xyz="0 0.154 0" rpy="1.5708 0 0" />
    <parent link="Link_1" />
    <child link="Link_2" />
    <axis xyz="0 0 1" />
    <limit lower="-12.567" upper="12.567" effort="100" velocity="3.141" />
  </joint>

  <joint name="Joint_3" type="revolute">
    <origin xyz="0 -0.5 0.15" rpy="0 0 3.1416" />
    <parent link="Link_2" />
    <child link="Link_3" />
    <axis xyz="0 0 1" />
    <limit lower="-12.567" upper="12.567" effort="100" velocity="3.141" />
  </joint>

  <joint name="Joint_4" type="revolute">
    <origin xyz="0 0.5 -0.104" rpy="1.5708 0 0" />
    <parent link="Link_3" />
    <child link="Link_4" />
    <axis xyz="0 1 0" />
    <limit lower="-12.567" upper="12.567" effort="10" velocity="3.141" />
  </joint>

  <joint name="Joint_5" type="revolute">
