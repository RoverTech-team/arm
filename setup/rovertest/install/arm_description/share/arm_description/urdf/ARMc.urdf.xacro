<?xml version="1.0" encoding="utf-8"?>
<robot name="RAM.SLDASM" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="material" params="name color">
    <material name="${name}">
      <color rgba="${color}" />
    </material>
  </xacro:macro>

  <xacro:macro name="link_with_inertial_visual_collision" params="name mass xyz rpy ixx ixy ixz iyy iyz izz mesh color">
    <link name="${name}">
      <inertial>
        <origin xyz="${xyz}" rpy="${rpy}" />
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/${mesh}" />
        </geometry>
        <xacro:material name="" color="${color}" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/${mesh}" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>


  <xacro:link_with_inertial_visual_collision
    name="base_link"
    mass="0.27178231395986"
    xyz="0.185 0.0443946079565858 0.0443946079565859"
    rpy="0 0 0"
    ixx="0.000989352192710714"
    ixy="-1.40267106251707E-09"
    ixz="1.40267106280563E-09"
    iyy="0.00111822585709726"
    iyz="0.000234693504347095"
    izz="0.00111822585709726"
